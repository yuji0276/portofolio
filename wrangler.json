{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portofolio",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "yuji0276.dev",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
