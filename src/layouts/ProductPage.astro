---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"products">["data"];

const { title, description, date, stack, github, demo, role } = Astro.props;
---

<Base title={title} description={description} type="article">
	<article>
		<header class="head">
			<div class="wrap">
				<p class="back"><a href="/products">← 制作物一覧</a></p>
				<h1>{title}</h1>
				<p class="lead">{description}</p>

				<dl class="facts">
					<div>
						<dt>制作時期</dt>
						<dd><FormattedDate date={date} monthOnly /></dd>
					</div>
					{
						role && (
							<div>
								<dt>体制</dt>
								<dd>{role}</dd>
							</div>
						)
					}
					{
						stack.length > 0 && (
							<div>
								<dt>使用技術</dt>
								<dd>
									<ul class="stack">
										{stack.map((item) => (
											<li class="tag">{item}</li>
										))}
									</ul>
								</dd>
							</div>
						)
					}
				</dl>

				{
					(github || demo) && (
						<div class="actions">
							{github && (
								<a class="button button--ghost" href={github} target="_blank" rel="noopener noreferrer">
									GitHub リポジトリ
								</a>
							)}
							{demo && (
								<a class="button" href={demo} target="_blank" rel="noopener noreferrer">
									公開ページを開く
								</a>
							)}
						</div>
					)
				}
			</div>
		</header>

		<div class="wrap">
			<div class="prose">
				<slot />
			</div>
		</div>
	</article>
</Base>

<style>
	.head {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line-soft);
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.back {
		margin: 0 0 1.25rem;
	}

	.back a {
		font-family: var(--font-heading);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.back a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	h1 {
		margin: 0 0 0.75rem;
		max-width: var(--measure);
	}

	.lead {
		max-width: var(--measure);
		margin: 0 0 2rem;
		color: var(--text-muted);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, max-content));
		gap: 1.25rem 3rem;
		margin: 0;
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	dt {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	dd {
		margin: 0;
		font-size: 0.95rem;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.stack li {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
