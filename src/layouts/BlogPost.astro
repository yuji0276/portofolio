---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<Base title={title} description={description} type="article">
	<article>
		<header class="head">
			<div class="wrap">
				<div class="col">
					<p class="back"><a href="/blogs">← 記事一覧</a></p>
					<h1>{title}</h1>

					<div class="meta-row">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="meta">
									更新 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>

					{
						tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>
										<a class="tag" href={`/blogs/?tag=${encodeURIComponent(tag)}`}>
											{tag}
										</a>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</div>
		</header>

		<div class="wrap">
			<div class="col">
				<div class="prose">
					<slot />
				</div>
			</div>
		</div>
	</article>
</Base>

<style>
	/* 本文カラムをページ中央に揃える */
	.col {
		max-width: var(--measure);
		margin-inline: auto;
	}

	.head {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line-soft);
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.back {
		margin: 0 0 1.25rem;
	}

	.back a {
		font-family: var(--font-heading);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.back a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	h1 {
		margin: 0 0 1rem;
	}

	.meta-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.tags li {
		margin: 0;
	}

	.tags a:hover {
		border-color: var(--accent);
		color: var(--text);
	}
</style>
