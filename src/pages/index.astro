---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION, PROFILE, SOCIAL_LINKS } from "../consts";

const products = (await getCollection("products", ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">{PROFILE.role}</p>
			<h1>{PROFILE.name}</h1>
			<p class="tagline">{PROFILE.tagline}</p>

			<div class="actions">
				<a class="button" href="/products">制作物を見る</a>
				<a class="button button--ghost" href="/introduction">自己紹介</a>
			</div>
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<div class="head">
				<h2>制作物</h2>
				<a href="/products">すべて見る</a>
			</div>

			{
				products.length > 0 ? (
					<div class="grid">
						{products.map((product) => (
							<ProductCard
								href={`/products/${product.id}/`}
								title={product.data.title}
								description={product.data.description}
								date={product.data.date}
								stack={product.data.stack}
								github={product.data.github}
								demo={product.data.demo}
								role={product.data.role}
							/>
						))}
					</div>
				) : (
					<p class="empty">制作物はまだ公開していません。</p>
				)
			}
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<div class="head">
				<h2>記事</h2>
				<a href="/blogs">すべて見る</a>
			</div>

			{
				posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`/blogs/${post.id}/`}>
									<FormattedDate date={post.data.pubDate} />
									<span class="post-title">{post.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">記事はまだ公開していません。</p>
				)
			}
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<div class="contact card">
				<div>
					<h2>連絡先</h2>
					<p>
						ご連絡は<a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>までお願いします。
					</p>
				</div>
				<ul class="socials">
					{
						SOCIAL_LINKS.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="me noopener noreferrer">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero {
		padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 5rem);
		border-bottom: 1px solid var(--line-soft);
	}

	/*
	  肩書きには GDGoC のように大文字小文字が決まった固有名詞が入るため、
	  ここだけ大文字変換しない。字送りも小文字向けに詰める。
	*/
	.hero .eyebrow {
		text-transform: none;
		letter-spacing: 0.04em;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(2.75rem, 1.8rem + 4.5vw, 5rem);
		letter-spacing: -0.03em;
	}

	.tagline {
		max-width: var(--measure);
		margin: 1.5rem 0 0;
		font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.block {
		padding-block: clamp(3rem, 7vw, 4.5rem);
	}

	.block + .block {
		padding-top: 0;
	}

	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1.75rem;
	}

	.head h2 {
		margin: 0;
	}

	.head a {
		font-family: var(--font-heading);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.head a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line-soft);
	}

	.post-list li {
		margin: 0;
		border-bottom: 1px solid var(--line-soft);
	}

	.post-list a {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		padding: 1rem 0;
		color: var(--text);
		text-decoration: none;
	}

	.post-list a:hover .post-title {
		color: var(--accent-strong);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.post-title {
		font-family: var(--font-heading);
		font-weight: 500;
	}

	.contact {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.contact h2 {
		margin: 0 0 0.5rem;
	}

	.contact p {
		margin: 0;
		color: var(--text-muted);
	}

	.socials {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		align-items: center;
	}

	.socials li {
		margin: 0;
	}

	.empty {
		color: var(--text-muted);
	}

	@media (max-width: 560px) {
		.post-list a {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
