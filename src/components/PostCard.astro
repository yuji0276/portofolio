---
import FormattedDate from "./FormattedDate.astro";

interface Props {
	href: string;
	title: string;
	description: string;
	pubDate: Date;
	tags: string[];
}

const { href, title, description, pubDate, tags } = Astro.props;
---

<article class="post" data-tags={tags.join(",")}>
	<div class="head">
		<FormattedDate date={pubDate} />
		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((tag) => (
						<li class="tag">{tag}</li>
					))}
				</ul>
			)
		}
	</div>

	<h3><a href={href}>{title}</a></h3>
	<p class="desc">{description}</p>
</article>

<style>
	.post {
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.6rem;
	}

	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tags li {
		margin: 0;
	}

	h3 {
		margin: 0 0 0.4rem;
	}

	h3 a {
		color: var(--text);
		text-decoration: none;
	}

	/* カード全体をクリック領域にする(擬似要素で覆う) */
	h3 a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.post {
		position: relative;
	}

	h3 a:hover {
		color: var(--accent-strong);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.desc {
		margin: 0;
		max-width: var(--measure);
		color: var(--text-muted);
		font-size: 0.95rem;
	}
</style>
