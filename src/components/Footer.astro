---
import { SITE_TITLE, NAV_LINKS, SOCIAL_LINKS, PROFILE } from "../consts";

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<div>
			<p class="brand">{SITE_TITLE}</p>
			<p class="meta">{PROFILE.role} — {PROFILE.location}</p>
		</div>

		<div class="links">
			<nav aria-label="フッターナビゲーション">
				{NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>
			<nav aria-label="外部リンク">
				{
					SOCIAL_LINKS.map((link) => (
						<a href={link.href} target="_blank" rel="me noopener noreferrer">
							{link.label}
						</a>
					))
				}
				<a href="/rss.xml">RSS</a>
			</nav>
		</div>
	</div>

	<div class="wrap bottom">
		<p class="meta">&copy; {year} {SITE_TITLE}</p>
	</div>
</footer>

<style>
	footer {
		margin-top: clamp(4rem, 10vw, 7rem);
		border-top: 1px solid var(--line-soft);
		background: var(--surface);
		padding-block: 2.5rem 1.5rem;
	}

	.inner {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.brand {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}

	.links {
		display: flex;
		gap: clamp(1.5rem, 6vw, 4rem);
		flex-wrap: wrap;
	}

	.links nav {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.links a {
		font-size: 0.9rem;
		color: var(--text-muted);
		text-decoration: none;
	}

	.links a:hover {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.bottom {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-soft);
	}

	.bottom p {
		margin: 0;
	}
</style>
