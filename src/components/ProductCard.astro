---
import FormattedDate from "./FormattedDate.astro";

interface Props {
	href: string;
	title: string;
	description: string;
	date: Date;
	stack: string[];
	github?: string;
	demo?: string;
	role?: string;
}

const { href, title, description, date, stack, github, demo, role } =
	Astro.props;
---

<article class="card product">
	<div class="head">
		<FormattedDate date={date} monthOnly />
		{role && <span class="role">{role}</span>}
	</div>

	<h3><a href={href}>{title}</a></h3>
	<p class="desc">{description}</p>

	{
		stack.length > 0 && (
			<ul class="stack">
				{stack.map((item) => (
					<li class="tag">{item}</li>
				))}
			</ul>
		)
	}

	<div class="links">
		<a class="link" href={href}>紹介ページ</a>
		{
			github && (
				<a class="link" href={github} target="_blank" rel="noopener noreferrer">
					GitHub
					<span class="sr-only">(新しいタブで開く)</span>
				</a>
			)
		}
		{
			demo && (
				<a class="link" href={demo} target="_blank" rel="noopener noreferrer">
					公開ページ
					<span class="sr-only">(新しいタブで開く)</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.product {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.65rem;
	}

	.role {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.role::before {
		content: "/";
		margin-right: 0.5rem;
		color: var(--line);
	}

	h3 {
		margin: 0 0 0.5rem;
	}

	h3 a {
		color: var(--text);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent-strong);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.desc {
		margin: 0 0 1.25rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
	}

	.stack li {
		margin: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--line-soft);
	}

	.link {
		font-family: var(--font-heading);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--accent-strong);
		text-decoration: none;
	}

	.link:hover {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
